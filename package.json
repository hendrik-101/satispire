{
  "name": "satispire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "build": "tsc -p tsconfig.build.json",
    "plan": "tsx src/cli.ts",
    "mcp": "tsx src/adapters/stdio.ts",
    "test:discovery": "node scripts/discovery/synthetic-test.cjs",
    "check": "npm run test:discovery && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run smoke && npm run build:web",
    "test:browser": "playwright test",
    "smoke": "node scripts/smoke.mjs",
    "dev": "vite dev",
    "build:web": "vite build",
    "import:discovery": "tsx scripts/import-discovery.ts",
    "build:runtime": "npm run build && npm run build:web && node scripts/write-build-info.mjs",
    "start": "node dist/runtime/serve.js",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "test:container": "node scripts/container-smoke.mjs",
    "test:artifact": "node scripts/artifact-smoke.mjs",
    "test:browser:runtime": "playwright test --config playwright.runtime.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "convex": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.25.76",
    "srvx": "0.11.22"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "convex-test": "0.0.61",
    "eslint": "9.39.5",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
